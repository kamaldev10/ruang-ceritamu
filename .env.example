# Salin file ini ke ".env" lalu sesuaikan nilainya.

# Wajib diisi di production (lihat config.py -> ProductionConfig)
SECRET_KEY=ubah-secret-key-ini-di-production

# Environment: development | production | testing
FLASK_ENV=development

# ─── Database (MySQL) ────────────────────────────────────────────────
# Default cocok untuk Laragon (user root, password kosong). Ganti kalau
# setup MySQL-mu berbeda. Lihat db.py.
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=
DB_PORT=3306
DB_NAME=db_cerita

# ─── Email (Flask-Mail) ──────────────────────────────────────────────
# Dipakai untuk reset kata sandi lewat email.
# Kalau MAIL_SERVER dikosongkan, email TIDAK benar-benar dikirim —
# link reset akan dicatat ke logs/ceritakita.log sebagai gantinya,
# supaya tetap bisa ditest tanpa SMTP server sungguhan.
MAIL_SERVER=
MAIL_PORT=587
MAIL_USE_TLS=true
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_DEFAULT_SENDER=no-reply@ceritakita.id
# Set eksplisit ke "true"/"false" untuk override auto-detect di atas.
# MAIL_SUPPRESS_SEND=
